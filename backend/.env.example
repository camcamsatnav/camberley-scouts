# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# OAuth2 smtp
# If all three are set, OAuth2 will be used instead of plain password auth.
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
SMTP_REFRESH_TOKEN=


# Emails (comma-separated)
BEAVERS_EMAILS=email@example.com,email@example.com
CUBS_EMAILS=
SCOUTS_EMAILS=
VOLUNTEER_EMAILS=
GENERAL_EMAILS=
