{
  "name": "camberley-scouts-backend",
  "version": "1.0.0",
  "description": "The backend api for the Camberley Scouts website",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build:tsc": "tsc",
    "build:esbuild": "esbuild dist/index.js --bundle --platform=node --target=node16 --minify --outfile=dist/bundle.js",
    "build": "npm run build:tsc && npm run build:esbuild",
    "start": "node dist/bundle.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "@types/supertest": "^2.0.12",
    "esbuild": "0.25.0",
    "ts-node-dev": "^2.0.0"
  }
}
