{
  "name": "camberley-scouts-backend",
  "description": "The backend api for the Camberley Scouts website",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build:tsc": "tsc",
    "build:esbuild": "esbuild dist/index.js --bundle --platform=node --target=node25 --packages=external --minify --outfile=dist/bundle.js",
    "build": "npm run build:tsc && npm run build:esbuild",
    "start": "node dist/bundle.js",
    "test": "vitest run --silent"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.27.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^4.0.18"
  }
}
